<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>botzilla_fleet</name>
  <version>0.0.0</version>
  <description>Two-robot leader/collector coordination for BotZilla (PROJECT.md Phase 2)</description>
  <maintainer email="hirunamalavipathirana.333@gmail.com">hiruna</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>botzilla_interfaces</exec_depend>
  <exec_depend>botzilla_navigation</exec_depend>
  <exec_depend>botzilla_bringup</exec_depend>
  <exec_depend>botzilla_control</exec_depend>
  <exec_depend>botzilla_perception</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

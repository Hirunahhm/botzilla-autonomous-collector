<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>botzilla_straightline_planner</name>
  <version>0.0.1</version>
  <description>
    Nav2 global-planner plugin that plans a straight line between start and goal,
    used only for BotZilla's camera-coverage sweep legs (see botzilla_navigation's
    frontier_explorer_node) to avoid nav2_navfn_planner's cost-gradient curving
    between waypoints that are already known to be free.
  </description>
  <maintainer email="hirunamalavipathirana.333@gmail.com">hirunahhm</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>pluginlib</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/plugin.xml" />
  </export>
</package>

<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="botzilla_world">
    <!-- Global light source using Fuel URI -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>
    <!-- Ground plane using Fuel URI -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <!-- Warm wood-tone floor finish overlay (visual only; Ground Plane above keeps the physics collision) -->
    <model name="floor_finish">
      <static>true</static>
      <pose>0 0 0.0008 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>7.0 7.0 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.42 0.29 1</ambient>
            <diffuse>0.55 0.42 0.29 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- Home / Drop-Off Zone at Origin (0.0, 0.0)                 -->
    <!-- ========================================================= -->
    <model name="drop_off_zone">
      <static>true</static>
      <pose>0.0 0.0 0.0025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 0.6 0.005</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0.8 0 1</ambient> <!-- Green home zone -->
          </material>
        </visual>
      </link>
    </model>

    <!-- AprilTag / Marker Panel behind home zone -->
    <model name="drop_off_wall_panel">
      <static>true</static>
      <pose>0.0 -0.8 0.25 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 0.02 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient> <!-- White panel reference -->
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- N Collectible Target Cubes (N = 4)                        -->
    <!-- Scattered across different rooms to test frontier search  -->
    <!-- ========================================================= -->

    <!-- Cube 1: East Room (Upper) -->
    <model name="cube_1">
      <pose>2.2 2.2 0.05 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00008</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00008</iyy>
            <iyz>0</iyz>
            <izz>0.00008</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient> <!-- Red cube -->
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cube 2: East Room (Lower behind central partition) -->
    <model name="cube_2">
      <pose>2.5 -2.0 0.05 0 0 0.4</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00008</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00008</iyy>
            <iyz>0</iyz>
            <izz>0.00008</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cube 3: Northwest Room -->
    <model name="cube_3">
      <pose>-2.3 2.2 0.05 0 0 -0.3</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00008</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00008</iyy>
            <iyz>0</iyz>
            <izz>0.00008</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cube 4: Southwest Room -->
    <model name="cube_4">
      <pose>-2.3 -2.0 0.05 0 0 0.8</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00008</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00008</iyy>
            <iyz>0</iyz>
            <izz>0.00008</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- Multi-Height Obstacles (Testing Sensor Fusion)            -->
    <!-- ========================================================= -->

    <!-- Normal 2D LiDAR Pillar (Detected by LiDAR /scan at z=12cm) -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-1.8 -1.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.35 0.35 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.35 0.35 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- Low Floor Barrier (Below LiDAR plane z=12cm; caught by Kinect 3D VoxelLayer) -->
    <model name="low_barrier_1">
      <static>true</static>
      <pose>2.2 0.0 0.03 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.4 0.2 0.06</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.4 0.2 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.5 0.1 1</ambient> <!-- Orange low obstacle -->
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- Interior Partitions (Creating Occluded Rooms & Doorways)  -->
    <!-- ========================================================= -->

    <!-- Central Partition Wall (x = 1.2, from y = -3.5 to y = 1.0) -->
    <model name="partition_central">
      <static>true</static>
      <pose>1.2 -1.25 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 4.5 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 4.5 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.80 0.83 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- West Partition Wall (y = 0.5, from x = -3.5 to x = -1.3) -->
    <model name="partition_room_west">
      <static>true</static>
      <pose>-2.4 0.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.2 0.1 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.2 0.1 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.80 0.83 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- Room Furniture (visual/collision clutter for realism)     -->
    <!-- ========================================================= -->

    <!-- Table (north corridor, between the west and east rooms) -->
    <model name="table_1">
      <static>true</static>
      <pose>-1.0 2.7 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.5 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.5 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.3 0.15 1</ambient>
            <diffuse>0.45 0.3 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bookshelf against the east wall (east room) -->
    <model name="shelf_1">
      <static>true</static>
      <pose>3.2 2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 1.0 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 1.0 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.22 0.12 1</ambient>
            <diffuse>0.35 0.22 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- Static Human Figures (simplified torso+head mannequins)   -->
    <!-- Sensor-fusion test targets, one per room                  -->
    <!-- ========================================================= -->

    <!-- Human 1: East room -->
    <model name="human_1">
      <static>true</static>
      <pose>2.0 -0.8 0 0 0 0</pose>
      <link name="link">
        <collision name="torso_collision">
          <pose>0 0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="torso_visual">
          <pose>0 0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.55 1</ambient><diffuse>0.2 0.3 0.55 1</diffuse></material>
        </visual>
        <collision name="head_collision">
          <pose>0 0 1.32 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
        </collision>
        <visual name="head_visual">
          <pose>0 0 1.32 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.85 0.68 0.55 1</ambient><diffuse>0.85 0.68 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Human 2: South-center area -->
    <model name="human_2">
      <static>true</static>
      <pose>-1.0 -2.8 0 0 0 0</pose>
      <link name="link">
        <collision name="torso_collision">
          <pose>0 0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="torso_visual">
          <pose>0 0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.55 0.15 0.15 1</ambient><diffuse>0.55 0.15 0.15 1</diffuse></material>
        </visual>
        <collision name="head_collision">
          <pose>0 0 1.32 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
        </collision>
        <visual name="head_visual">
          <pose>0 0 1.32 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.85 0.68 0.55 1</ambient><diffuse>0.85 0.68 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Human 3: Northwest room -->
    <model name="human_3">
      <static>true</static>
      <pose>-2.8 1.5 0 0 0 0</pose>
      <link name="link">
        <collision name="torso_collision">
          <pose>0 0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="torso_visual">
          <pose>0 0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.2 0.5 0.25 1</ambient><diffuse>0.2 0.5 0.25 1</diffuse></material>
        </visual>
        <collision name="head_collision">
          <pose>0 0 1.32 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
        </collision>
        <visual name="head_visual">
          <pose>0 0 1.32 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.85 0.68 0.55 1</ambient><diffuse>0.85 0.68 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- Additional Indoor Clutter (chairs, sofa, plant, bin, crates) -->
    <!-- ========================================================= -->

    <!-- Chair near shelf (east room) -->
    <model name="chair_1">
      <static>true</static>
      <pose>2.8 2.8 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.45</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.45</size></box></geometry>
          <material><ambient>0.3 0.35 0.45 1</ambient><diffuse>0.3 0.35 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Chair near table (center corridor) -->
    <model name="chair_2">
      <static>true</static>
      <pose>-0.3 2.5 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.45</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.45</size></box></geometry>
          <material><ambient>0.3 0.35 0.45 1</ambient><diffuse>0.3 0.35 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Sofa (southwest room) -->
    <model name="sofa_1">
      <static>true</static>
      <pose>-2.7 -2.6 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.45 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.45 0.4</size></box></geometry>
          <material><ambient>0.15 0.35 0.2 1</ambient><diffuse>0.15 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Potted plant (southwest room) -->
    <model name="plant_1">
      <static>true</static>
      <pose>-3.0 -0.8 0 0 0 0</pose>
      <link name="link">
        <collision name="pot_collision">
          <pose>0 0 0.125 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.25</length></cylinder></geometry>
        </collision>
        <visual name="pot_visual">
          <pose>0 0 0.125 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.6 0.3 0.15 1</ambient><diffuse>0.6 0.3 0.15 1</diffuse></material>
        </visual>
        <collision name="foliage_collision">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
        </collision>
        <visual name="foliage_visual">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><sphere><radius>0.22</radius></sphere></geometry>
          <material><ambient>0.15 0.45 0.15 1</ambient><diffuse>0.15 0.45 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Trash bin (center corridor) -->
    <model name="trash_bin_1">
      <static>true</static>
      <pose>0.7 -1.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Debris crate (east room) -->
    <model name="crate_1">
      <static>true</static>
      <pose>2.8 -3.0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.55 0.4 0.2 1</ambient><diffuse>0.55 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Debris crate (northwest room) -->
    <model name="crate_2">
      <static>true</static>
      <pose>-1.6 3.0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.55 0.4 0.2 1</ambient><diffuse>0.55 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- Outer Arena Perimeter Walls (7.0m x 7.0m)                 -->
    <!-- ========================================================= -->

    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7.0 0.1 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>7.0 0.1 0.6</size></box></geometry>
          <material><ambient>0.87 0.84 0.76 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7.0 0.1 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>7.0 0.1 0.6</size></box></geometry>
          <material><ambient>0.87 0.84 0.76 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>3.5 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 7.0 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 7.0 0.6</size></box></geometry>
          <material><ambient>0.87 0.84 0.76 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-3.5 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 7.0 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 7.0 0.6</size></box></geometry>
          <material><ambient>0.87 0.84 0.76 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Physics settings for high-precision differential drive & capture -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
  </world>
</sdf>
<?xml version="1.0"?>
<robot name="botzilla_qbot">

  <!-- =============== Base Footprint =============== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.00" rpy="0 0 0"/>
  </joint>

  <!-- =============== Base Link (Chassis) =============== -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.17" length="0.09"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.17" length="0.09"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.4"/>
      <inertia ixx="0.019" ixy="0.0" ixz="0.0" iyy="0.019" iyz="0.0" izz="0.034"/>
    </inertial>
  </link>

  <!-- =============== Left Wheel =============== -->
  <link name="wheel_left_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.115 -0.025" rpy="-1.570796 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- =============== Right Wheel =============== -->
  <link name="wheel_right_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.115 -0.025" rpy="-1.570796 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- =============== Caster Wheel =============== -->
  <link name="caster_front_link">
    <collision>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front_link"/>
    <origin xyz="0.115 0.0 -0.045" rpy="0 0 0"/>
  </joint>

  <link name="caster_back_link">
    <collision>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_link"/>
    <origin xyz="-0.135 0.0 -0.045" rpy="0 0 0"/>
  </joint>

  <!-- =============== RGB-D Camera (Kinect) =============== -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.06 0.25 0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.25 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.0 0 0.19" rpy="0 0 0"/>
  </joint>

  <!-- ROS optical-frame convention (Z-forward, X-right, Y-down), required by
       RTAB-Map / image_geometry for correct depth-to-3D projection. -->
  <link name="camera_link_optical"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <!-- =============== Pushing Arms (Front Plates) =============== -->
  <!-- Left Arm -->
  <link name="arm_left_link">
    <visual>
      <geometry>
        <box size="0.15 0.02 0.08"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.02 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="arm_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_left_link"/>
    <!-- Positioned straight forward with 0 rotation -->
    <!-- x=0.235 puts the arm tip at 0.235 + 0.15/2 = 0.310, which is the MEASURED front
         of the grabber arms on the physical robot (nav2_params.yaml's local_costmap
         footprint comment: "front x = +0.310, rear x = -0.170, half-width 0.165", from
         0.48 m arms-to-chassis-back and 0.33 m across). Was 0.18, which reached only
         0.255 and modelled the simulated robot 55 mm SHORTER than the real one — so
         Gazebo showed clearance the hardware would not have had, and any sim result
         about squeezing past obstacles would not transfer. The Nav2 footprint is
         correct and stays as measured; this is the model catching up to it. -->
    <origin xyz="0.235 0.08 -0.01" rpy="0 0 0"/>
  </joint>

  <!-- Right Arm -->
  <link name="arm_right_link">
    <visual>
      <geometry>
        <box size="0.15 0.02 0.08"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.15 0.02 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="arm_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_right_link"/>
    <!-- Positioned straight forward with 0 rotation -->
    <!-- Mirror of arm_left_joint — see its comment for the 0.18 -> 0.235 measurement. -->
    <origin xyz="0.235 -0.08 -0.01" rpy="0 0 0"/>
  </joint>

  <!-- =============== 2D LiDAR (Laser Frame) =============== -->
  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.0 0.0 0.24" rpy="0 0 0"/>
  </joint>

  <!-- =============== IMU Link & Joint =============== -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- =============== Gazebo Plugins (Harmonic) =============== -->
  <gazebo>
    <!-- Differential Drive -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.23</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <publish_odom_tf>false</publish_odom_tf>
    </plugin>
    <!-- IMU System Plugin -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <!-- 640x480 -> 320x240. At 640x480 each /camera/points cloud carries 307,200
             points (~5-10 MB); bridging that through ros_gz_bridge at 30 Hz is ~300 MB/s,
             which this Jetson cannot do. Measured effect: /camera/points collapsed to
             0.1 Hz — ONE cloud every 12 s — and /scan_camera with it, since it can only
             be as fast as its input. That is the depth-as-laserscan stream the costmap
             relies on for LOW obstacles: the 2D lidar sits at laser_frame z=0.24 and
             sweeps clean over a 0.1 m cube, so with this throttled there was nothing
             watching the floor and the robot drove into cubes. At 0.2 m/s it covered 2 m
             between obstacle updates.
             320x240 is 4x fewer points; combined with the update_rate change below that
             is ~8x less bridge traffic. Ample to see a 0.1 m cube at 0.5-3.0 m (the
             pointcloud_to_laserscan range band), and YOLO letterboxes its input anyway,
             so cube DETECTION is unaffected. Sim only — hardware uses the real Kinect. -->
        <image>
          <width>320</width>
          <height>240</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <optical_frame_id>camera_link_optical</optical_frame_id>
      </camera>
      <always_on>1</always_on>
      <!-- 30 -> 15 Hz. See the <image> comment above: this halves bridge traffic again.
           15 Hz still gives the costmap an obstacle update every 0.067 s (13 mm of travel
           at 0.2 m/s) versus the 2 m it was managing at the measured 0.1 Hz. The lidar
           runs at 15 Hz too, so the two obstacle sources now update in step. -->
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
    </sensor>
  </gazebo>

  <gazebo reference="laser_frame">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <!-- A real IMU always has noise; without a noise model Gazebo publishes an
           all-zero covariance matrix, which robot_localization's EKF reads as
           "zero uncertainty" (absolute certainty) rather than "unknown" — making
           the filter snap to any single glitchy reading instead of blending it
           against the wheel odometry. These are typical low-cost MEMS MPU-6050-
           class stddevs, standard reference values used across ROS/Gazebo IMU configs. -->
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0003</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>